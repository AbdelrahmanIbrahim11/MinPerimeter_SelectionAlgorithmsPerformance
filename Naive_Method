public class Naive_Method {

    long selcet (long[] array, int k) {
        long temp = 0 ;
        for (int i = 0 ; i < array.length - 1 ; i ++ ) {
            for (int j = i + 1 ; j < array.length ; j ++ ) {
                if (array[j] < array[i]) {
                    temp = array[j] ;
                    array[j] = array[i] ;
                    array[i] = temp ;

                }
            }
        }

        return array[k-1] ; 

    }

}